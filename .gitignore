# Secrets — never commit
.env
.env.*
!.env.example
*.pem
*-key.json
**/credentials/
**/.near-credentials/

# E2E / seed runtime artifacts (keep static fixtures like scripts/init-args.json)
scripts/e2e-last-run.log
scripts/seed-last-run.log
scripts/e2e-args/*.runtime.json
scripts/e2e-args/bal-*.json
scripts/seed-args/*.json
!scripts/seed-args/.gitkeep
new-args.json
**/new-args.json

# Rust / WASM build output
**/target/
contract/Cargo.lock
**/*.wasm
**/neardev/

# Node / Next
web/node_modules/
web/.next/
web/.next-build/
web/.next-build-ci/
web/out/
web/coverage/
npm-debug.log*

# Vercel / deploy
.vercel/
web/.vercel/
.deploy-args/

