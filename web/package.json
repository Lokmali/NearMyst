{
  "name": "nearmyst-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/check-port.mjs",
    "dev": "next dev",
    "dev:clean": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\" && node scripts/check-port.mjs && next dev",
    "build": "next build",
    "build:local": "node scripts/next-with-dist.mjs build",
    "build:isolated": "node scripts/next-with-dist.mjs build",
    "start": "next start",
    "start:local": "node scripts/next-with-dist.mjs start",
    "start:isolated": "node scripts/next-with-dist.mjs start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@near-js/providers": "^2.5.1",
    "@near-js/types": "^2.5.1",
    "@near-js/utils": "^2.5.1",
    "@near-wallet-selector/core": "^10.1.4",
    "@near-wallet-selector/here-wallet": "^10.1.4",
    "@near-wallet-selector/hot-wallet": "^10.1.4",
    "@near-wallet-selector/intear-wallet": "^10.1.4",
    "@near-wallet-selector/ledger": "^10.1.4",
    "@near-wallet-selector/meteor-wallet": "^10.1.4",
    "@near-wallet-selector/modal-ui": "^10.1.4",
    "@near-wallet-selector/my-near-wallet": "^10.1.4",
    "@near-wallet-selector/near-mobile-wallet": "^10.1.4",
    "@near-wallet-selector/nightly": "^10.1.4",
    "@near-wallet-selector/react-hook": "^10.1.4",
    "@near-wallet-selector/sender": "^10.1.4",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.70.0",
    "motion": "^14.12.0",
    "near-api-js": "6.5.1",
    "next": "15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.1.0",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "near-api-js": "6.5.1"
